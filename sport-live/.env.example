# typesafe ou openrouter
JEV_PROVIDER=typesafe

# Preencha somente a chave do provedor escolhido.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

TYPESAFE_MODEL=jev-latest
OPENROUTER_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=10

# 1 = Jev simulado (heurística local), só para desenvolver a tela sem chave.
JEV_FAKE=
