# Azure DevOps
ADO_ORG=exemplo-org
ADO_PROJECT=Projeto Demo
ADO_TEAM=Team-demo
# PAT com escopo Work Items (Read; Read & Write se ALLOW_WRITE=true)
AZURE_DEVOPS_PAT=

# typesafe ou openrouter. Preencha somente a chave do provedor escolhido.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
OPENROUTER_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=30
JEV_MAX_CONCURRENCY=8

# Gravar SR_TAMANHO no ADO a partir da interface. Desligado por padrão.
ALLOW_WRITE=false
