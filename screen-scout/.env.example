# typesafe ou openrouter
JEV_PROVIDER=typesafe

# Preencha somente a chave do provedor escolhido.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=

TYPESAFE_MODEL=jev-latest
OPENROUTER_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=30

# 1 = Jev simulado (heurística local), só para desenvolver a tela sem chave.
JEV_FAKE=

# Navegador: vazio usa o Chromium do Playwright; msedge ou chrome usam o instalado.
SCOUT_BROWSER_CHANNEL=
# 1 = mostra o navegador durante a exploração.
SCOUT_HEADED=
# Sondagens em paralelo (contextos isolados do mesmo navegador).
SCOUT_CONCURRENCY=6
