# Azure DevOps — PAT com leitura de Work Items e Work (capacidade/iterações).
AZURE_DEVOPS_PAT=
ADO_ORG=senior-sistemas
ADO_PROJECT=IA - Senior
ADO_TEAM=Speed

# typesafe ou openrouter. Preencha somente a chave do provedor escolhido.
JEV_PROVIDER=typesafe
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_MODEL=jev-latest
OPENROUTER_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_SECONDS=30
# Chamadas simultâneas ao Jev durante a análise.
JEV_CONCURRENCY=16

PORT=8766
